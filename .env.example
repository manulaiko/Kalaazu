# Compose "stack name" (project name)
COMPOSE_PROJECT_NAME=kalaazu-dev

# Host connection settings your Spring app will use
MYSQL_HOST=localhost
MYSQL_PORT=43306
MYSQL_DATABASE=kalaazu

# App user (avoid root for the app)
MYSQL_USERNAME=kalaazu_user
MYSQL_PASSWORD=change_me

# Root password for MariaDB initialization
MYSQL_ROOT_PASSWORD=change_me_root
